#!/bin/sh

echo "Running pre-commit hooks..."

# Get list of PHP files that are staged for commit
STAGED_PHP_FILES=$(git diff --cached --name-only --diff-filter=d | grep ".php$")

if [ "$STAGED_PHP_FILES" = "" ]; then
    echo "No PHP files to check."
    exit 0
fi

# PHP Syntax check
echo "Checking PHP syntax..."
for FILE in $STAGED_PHP_FILES; do
    if [ -f "$FILE" ]; then
        php -l "$FILE"
        if [ $? -ne 0 ]; then
            echo "PHP syntax check failed for: $FILE"
            exit 1
        fi
    fi
done

# Run import checker script
echo "Checking PHP imports..."
php ./scripts/check-imports.php "$STAGED_PHP_FILES"
if [ $? -ne 0 ]; then
    echo "Import check failed!"
    exit 1
fi

echo "All checks passed!"
exit 0
